# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Fleet API base (default is the hosted LangSmith Fleet API)
FLEET_API_BASE=https://api.smith.langchain.com/v1/fleet

# A Fleet-enabled LangSmith API key (lsv2_...). Read server-side only.
FLEET_API_KEY=

# The workspace (tenant) UUID the app operates in. Required by most endpoints.
FLEET_TENANT_ID=

# Optional: organization UUID (used for tenant/user lookups).
FLEET_ORG_ID=

# Optional: override the workspace Agent Builder agent id used by /agents/new.
# NEXT_PUBLIC_AGENT_BUILDER_ID=

# --- Auth (Google OAuth via NextAuth/Auth.js) ---
# Gates the whole site behind Google sign-in. Only accounts whose verified
# email domain is in ALLOWED_EMAIL_DOMAINS may sign in (enforced in auth.ts).

# Public URL of the deployment. Local: http://localhost:3030
# On Vercel, set this to the production URL (e.g. https://your-app.vercel.app).
# Auth.js v5 also accepts AUTH_URL as an alias.
NEXTAUTH_URL=http://localhost:3030

# Random secret used to sign session tokens. Generate with: openssl rand -base64 32
# Auth.js v5 also accepts AUTH_SECRET as an alias.
NEXTAUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID → Web application). Authorized redirect URIs:
#   http://localhost:3030/api/auth/callback/google        (local)
#   https://<your-vercel-domain>/api/auth/callback/google  (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of allowed email domains. REQUIRED — if empty, all
# sign-ins are denied (fail closed). Example: langchain.dev,langchain.com
ALLOWED_EMAIL_DOMAINS=langchain.dev
